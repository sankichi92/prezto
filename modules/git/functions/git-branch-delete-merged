#
# Deletes local branches merged into HEAD, removing their linked worktrees first.
#

# function git-branch-delete-merged {

local branch current line worktree_path
local -A worktree_paths

current="$(command git symbolic-ref --quiet --short HEAD)" || return

while IFS= read -r line; do
  case "$line" in
    'worktree '*)
      worktree_path="${line#worktree }"
      ;;
    'branch refs/heads/'*)
      worktree_paths[${line#branch refs/heads/}]="$worktree_path"
      ;;
  esac
done < <(command git worktree list --porcelain)

for branch in "${(@f)$(command git for-each-ref --merged HEAD --format='%(refname:short)' refs/heads)}"; do
  [[ -z "$branch" ]] && continue
  [[ "$branch" == "$current" ]] && continue

  if [[ -n "${worktree_paths[$branch]-}" ]]; then
    command git worktree remove -- "${worktree_paths[$branch]}" || continue
  fi

  command git branch --delete -- "$branch"
done

# }
